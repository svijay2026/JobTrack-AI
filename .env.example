# Application Settings
PROJECT_NAME="JobTrack AI"
API_V1_STR="/api/v1"
DEBUG=True

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=jobtrack_ai

# Security & JWT
# Note: Generate a strong secret key in production (e.g. openssl rand -hex 32)
SECRET_KEY=jobtrack_ai_super_secret_development_key_change_in_production_32chars!
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# File Upload Settings
UPLOAD_DIR=uploads/resumes
MAX_UPLOAD_SIZE_MB=5
